{
  "name": "@lvce-editor/component-state-worker-monorepo",
  "version": "0.0.0-dev",
  "description": "Live component state inspector for LVCE Editor",
  "repository": {
    "type": "git",
    "url": "https://github.com/lvce-editor/component-state-worker.git"
  },
  "license": "MIT",
  "author": "Lvce Editor",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "node packages/build/src/build.ts",
    "build:static": "node packages/build/src/build-static.ts",
    "build:watch": "npm exec --workspace=packages/build -- esbuild --format=esm --bundle --watch packages/component-state-worker/src/componentStateWorkerMain.ts --outfile=.tmp/dist/dist/componentStateWorkerMain.js",
    "dev": "node packages/build/src/dev.ts",
    "e2e": "npm run e2e --workspace=packages/e2e",
    "e2e:firefox": "npm run e2e:firefox --workspace=packages/e2e",
    "e2e:firefox:headless": "npm run e2e:firefox:headless --workspace=packages/e2e",
    "e2e:headless": "npm run e2e:headless --workspace=packages/e2e",
    "e2e:webkit": "npm run e2e:webkit --workspace=packages/e2e",
    "e2e:webkit:headless": "npm run e2e:webkit:headless --workspace=packages/e2e",
    "format": "prettier --write .",
    "lint": "eslint . && prettier --check . && knip --no-config-hints",
    "test": "npm test --workspaces --if-present",
    "type-check": "tsc -b"
  },
  "prettier": {
    "semi": false,
    "singleQuote": true,
    "printWidth": 140
  },
  "devDependencies": {
    "@lvce-editor/eslint-config": "^18.3.0",
    "eslint": "^10.8.1",
    "knip": "^6.29.0",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3"
  },
  "optionalDependencies": {
    "@rollup/rollup-darwin-arm64": "4.62.2",
    "@rollup/rollup-linux-arm64-gnu": "4.62.2",
    "@rollup/rollup-win32-x64-msvc": "4.62.2"
  },
  "engines": {
    "node": ">=24"
  }
}
