    "e2e:headless": "node ./runHeadlessE2e.mjs",
    "e2e:webkit": "test-with-playwright --only-extension=../../.tmp/extensions/builtin.language-features-json --test-path=. --server-path=../build/src/startServer.ts --browser=webkit",
    "e2e:webkit:headless": "test-with-playwright --only-extension=../../.tmp/extensions/builtin.language-features-json --test-path=. --server-path=../build/src/startServer.ts --browser=webkit --headless",
    "type-check": "tsc"
